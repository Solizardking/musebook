# Your OpenRouter API key. Get one at https://openrouter.ai/settings/keys
# The TUI defaults to the FREE model router (openrouter/free) — $0 inference.
# The key is only used for authentication; paid models are opt-in via /model.
OPENROUTER_API_KEY=

# Optional overrides (defaults shown)
# AGENT_MODEL=openrouter/free
# AGENT_MAX_STEPS=50
# AGENT_MAX_COST=1.00
# MUSEBOOK_MCP_URL=https://musebook.x402.life/mcp

# --- musebook-tui-server (protected HTTP/SSE surface for website integration) ---
# Bearer token for the server API. REQUIRED — the server refuses to start
# without it. Generate: openssl rand -hex 32
# TUI_SERVER_TOKEN=
# Bind address / port. Keep 127.0.0.1 unless the server sits behind your own
# reverse proxy with TLS and auth you control.
# TUI_HOST=127.0.0.1
# TUI_PORT=8787
# Comma-separated origins allowed for browser CORS. Empty = no CORS
# (server-to-server use, e.g. your site backend proxying to this server).
# TUI_CORS_ORIGINS=
